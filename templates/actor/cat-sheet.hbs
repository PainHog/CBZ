<section class="catb-sheet-body {{cssClass}}">
  <header class="catb-sheet-head">
    <img class="catb-portrait" src="{{actor.img}}" alt="{{actor.name}}" data-edit="img">
    <div class="catb-name">
      <input type="text" name="name" value="{{actor.name}}" placeholder="Street name" {{#unless editable}}disabled{{/unless}}>
      <p class="catb-sub">Cattitude, Lives and the dice — Chapter 2.</p>
    </div>
  </header>

  {{#if warnings.length}}<ul class="catb-warn">{{#each warnings}}<li>{{this}}</li>{{/each}}</ul>{{/if}}

  <h3>Approaches</h3>
  <table class="catb-approaches">
    <tbody>
      {{#each approaches}}
      <tr>
        <th title="{{this.hint}}">{{this.label}} <span class="catb-role">({{this.role}})</span></th>
        <td><input type="number" name="system.approaches.{{this.key}}" value="{{this.value}}" min="1" max="4" {{#unless ../editable}}disabled{{/unless}}></td>
        <td>{{#if ../owner}}<button type="button" data-action="roll" data-approach="{{this.key}}">Roll {{this.label}}</button>{{/if}}</td>
      </tr>
      {{/each}}
    </tbody>
  </table>

  <div class="catb-grid">
    <div class="form-group">
      <label>Instincts</label>
      <select name="system.instinct1" {{#unless editable}}disabled{{/unless}}>{{#each instinct1}}<option value="{{this.value}}" {{#if this.selected}}selected{{/if}}>{{this.label}}</option>{{/each}}</select>
      <select name="system.instinct2" {{#unless editable}}disabled{{/unless}}>{{#each instinct2}}<option value="{{this.value}}" {{#if this.selected}}selected{{/if}}>{{this.label}}</option>{{/each}}</select>
    </div>
    <ul class="catb-instinct-info">
      {{#each instinctInfo}}<li><strong>{{this.label}}</strong> — Knack: +1 die to {{this.knack}}. Can't resist {{this.tempt}}.</li>{{/each}}
    </ul>
    <div class="form-group">
      <label>Body</label>
      <select name="system.body" {{#unless editable}}disabled{{/unless}}>{{#each bodies}}<option value="{{this.value}}" {{#if this.selected}}selected{{/if}}>{{this.label}}</option>{{/each}}</select>
      <p class="catb-note">{{bodyHint}}</p>
    </div>
    <div class="form-group">
      <label>Cattitude (max {{cattitudeMax}})</label>
      <input type="number" name="system.cattitude" value="{{system.cattitude}}" min="0" max="{{cattitudeMax}}" {{#unless editable}}disabled{{/unless}}>
    </div>
    <div class="form-group">
      <label>Lives (of {{livesMax}})</label>
      <input type="number" name="system.lives" value="{{system.lives}}" min="0" max="{{livesMax}}" {{#unless editable}}disabled{{/unless}}>
    </div>
    <div class="form-group">
      <label>Rep (campaign)</label>
      <input type="number" name="system.rep" value="{{system.rep}}" min="0" {{#unless editable}}disabled{{/unless}}>
    </div>
  </div>

  {{#if robbery}}
  <section class="catb-in-robbery">
    <h3>In the robbery at {{robbery.house}} — round {{robbery.round}}</h3>
    <p>{{robbery.where}} ({{robbery.status}}){{#if robbery.hidden}}, hidden{{/if}}{{#if robbery.carrying}}, carrying the {{robbery.carrying}}{{/if}}. {{robbery.turn}}.</p>
    {{#if robbery.rolls.length}}<p class="catb-note">Rolls you could make now: {{#each robbery.rolls}}{{this}}; {{/each}}</p>{{/if}}
    <button type="button" data-action="tracker">Open the Robbery Tracker</button>
  </section>
  {{/if}}

  <h3>Looks</h3>
  <div class="catb-grid">
    <div class="form-group"><label>Coat</label><input type="text" name="system.coat" value="{{system.coat}}" {{#unless editable}}disabled{{/unless}}></div>
    <div class="form-group"><label>Mark</label><input type="text" name="system.mark" value="{{system.mark}}" {{#unless editable}}disabled{{/unless}}></div>
    <div class="form-group"><label>Eyes</label><input type="text" name="system.eyes" value="{{system.eyes}}" {{#unless editable}}disabled{{/unless}}></div>
    <div class="form-group"><label>Quirk</label><input type="text" name="system.quirk" value="{{system.quirk}}" {{#unless editable}}disabled{{/unless}}></div>
  </div>
  <div class="form-group stacked">
    <label>Notes</label>
    <textarea name="system.notes" rows="4" {{#unless editable}}disabled{{/unless}}>{{system.notes}}</textarea>
  </div>
</section>
