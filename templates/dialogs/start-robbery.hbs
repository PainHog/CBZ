<div class="cat-burglars catb-start-dialog">
  <div class="form-group">
    <label>House</label>
    <select name="house">
      {{#each houses}}<option value="{{this.key}}" {{#if this.selected}}selected{{/if}}>{{this.name}} ({{this.label}})</option>{{/each}}
    </select>
  </div>
  <fieldset>
    <legend>The gang (3 to 5 cats)</legend>
    {{#each cats}}<label class="checkbox"><input type="checkbox" name="cat-{{this.id}}" {{#if this.checked}}checked{{/if}}> {{this.name}}</label>{{/each}}
  </fieldset>
  <p class="catb-note">Every cat starts outside with its starting Cattitude (2; 3 in a gang of three).</p>
</div>
