<div class="cat-burglars catb-card catb-{{kind}}">
  <header class="catb-card-head">
    <h3>{{title}}</h3>
    {{#if subtitle}}<p class="catb-sub">{{subtitle}}</p>{{/if}}
  </header>
  {{#if lines.length}}
  <ul class="catb-lines">
    {{#each lines}}<li class="{{this.cls}}">{{this.text}}</li>{{/each}}
  </ul>
  {{/if}}
  {{#if meters}}
  <p class="catb-meters"><span class="catb-broom">Broom {{meters.broom}}/{{meters.patience}}</span> · <span class="catb-cuddle">Cuddle {{meters.cuddle}}/{{meters.patience}}</span></p>
  {{/if}}
  {{#if footer}}<p class="catb-note">{{footer}}</p>{{/if}}
  <div class="catb-buttons"></div>
</div>
